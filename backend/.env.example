# Copy to .env and fill in real values:  cp .env.example .env
# REQUIRED — the server will NOT start without these:
#   NODE_ENV, PORT, APP_BASE_URL, API_BASE_URL, CORS_ORIGINS, MONGODB_URI, JWT_SECRET, CSRF_SECRET

# App
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
API_BASE_URL=http://localhost:4000/api
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# In production the API also serves the built SPA so everything stays on one
# origin (cookies remain first-party). Point this at the built frontend:
#   PUBLIC_DIR=../frontend/dist
# Empty (default) = API-only mode.
PUBLIC_DIR=

# Bootstrap SUPER_ADMIN — `npm run seed` promotes this mobile number (OTP-login).
# Admin login is OTP-based; there is no password login in this app.
ADMIN_MOBILE=919999999999

# Database
MONGODB_URI="mongodb+srv://user:pass@cluster.example.net/dbname?retryWrites=true&w=majority"

# Auth — generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
CSRF_SECRET=
COOKIE_DOMAIN=

# Payments
# In production: MUST be a live key (rzp_live_*), NOT rzp_test_*. The server
# refuses to boot with a test key when NODE_ENV=production.
RAZORPAY_KEY_ID=rzp_...
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=guddi-silai

# WhatsApp Business Cloud API — the single OTP + order-notification channel.
# Direct Meta integration, NO third-party BSP (MSG91 etc. removed).
#
# Credentials are MODE-SCOPED: test and production each carry their own phone
# number id / business account id / access token. WHATSAPP_MODE picks which set
# is used. There is NO fallback — production mode NEVER uses test credentials.
#
# TEST setup (meta Developer dashboard "Try it out" test number):
#   1. developers.facebook.com → create app → add "WhatsApp" product
#   2. Copy the test PHONE_NUMBER_ID and BUSINESS_ACCOUNT_ID below
#   3. Generate an access token in the dashboard and put it in
#      WHATSAPP_TEST_ACCESS_TOKEN
#   4. Add your own number to Meta as a test recipient AND list it in
#      WHATSAPP_TEST_NUMBERS — those are the only numbers reachable in test mode
#
# Webhooks (delivery status) — TWO values, both used per role:
#   WHATSAPP_VERIFY_TOKEN = a secret YOU invent; type the exact same string into
#                            Meta's "Verify token" field (it is echoed back on
#                            the GET challenge; it is NOT the access token)
#   WHATSAPP_APP_SECRET   = the Meta App secret; used to HMAC-verify every
#                            webhook POST (X-Hub-Signature-256). Not needed to
#                            SEND, but REQUIRED in production mode.
#
# Webhook URL (set in the Meta app → Webhooks → WhatsApp):
#   https://YOUR_HOST/api/whatsapp/webhook
#   (legacy alias: https://YOUR_HOST/api/webhooks/whatsapp)
#
# Messages arrive ~4s after being queued (background worker, never inside the
# order/checkout HTTP request).
WHATSAPP_ENABLED=true
# test = only numbers listed in WHATSAPP_TEST_NUMBERS (safe default);
# production = real customers via WHATSAPP_PRODUCTION_* credentials.
# Production mode REQUIRES the WHATSAPP_PRODUCTION_* credentials below and
# WHATSAPP_MODE=production; without them the server refuses to boot.
WHATSAPP_MODE=test

# ---- TEST credentials (Meta test number / test token) ----
WHATSAPP_TEST_PHONE_NUMBER_ID=
WHATSAPP_TEST_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEST_ACCESS_TOKEN=

# ---- PRODUCTION credentials (fill in after Meta production setup) ----
WHATSAPP_PRODUCTION_PHONE_NUMBER_ID=
WHATSAPP_PRODUCTION_BUSINESS_ACCOUNT_ID=
WHATSAPP_PRODUCTION_ACCESS_TOKEN=

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEST_NUMBERS=919999999999
WHATSAPP_API_VERSION=v25.0

# Shiprocket (shipping)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
# 'true' = mock Shiprocket (default in dev), 'false' = always live, unset = mock in dev only
SHIPROCKET_MOCK=

# AI (admin product descriptions / image analysis)
# PRIMARY — Google Gemini free tier (recommended: FREE, cloud, no server RAM)
# Get a free key: https://aistudio.google.com/apikey
# gemini-2.5-flash = best quality; gemini-2.5-flash-lite = ~100x higher free daily limits
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# FALLBACK — Groq hosting qwen/qwen3.8-27b (only used when GEMINI_API_KEY is empty)
GROQ_API_KEY=
QWEN_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Contact / business
WHATSAPP_NUMBER=919999999999
CALL_NUMBER=919999999999
ADMIN_MOBILE=
USD_RATE_INR=88
SHIPPING_FLAT_INR=79
FREE_SHIPPING_ABOVE_INR=1499

# Google login/signup (optional) — "Login with Google" button on the same login
# page; number/OTP login continues to work side by side.
#
# Steps (30 seconds):
#   1. console.cloud.google.com → apis & services → Credentials
#   2. Create a new "OAuth 2.0 Client ID" of type Web application
#      Authorized JavaScript origins:  https://<your-app-domain>  + http://localhost:4000
#      For dev with our stack the origin is the FRONTEND origin the browser sees
#      (e.g. http://localhost:5173 for the Vite dev server).
#   3. Paste the "Client ID" below. Google's key starts with a number then
#      ".apps.googleusercontent.com". Nobody needs the secret for this flow.
#   4. Restart the backend. The Google button appears automatically on login.
#
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# Comma-separated Google (email) accounts that become SUPER_ADMIN automatically
# on sign-in — the store owner uses this to reach the full admin panel.
#   Example:  GOOGLE_ADMIN_EMAILS=guddi7709894512@gmail.com,someone@example.com
# Leave empty to disable auto-promotion (admins are then added only via SUPER_ADMIN panel).
GOOGLE_ADMIN_EMAILS=

# Check all required env vars are present before starting:
#   npm run dev            (in backend/)