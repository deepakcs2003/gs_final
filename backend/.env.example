# ---------------------------------------------------------------------------
# Guddi Silai — backend environment
#
# Copy to `.env` and fill in real values.  NEVER commit `.env`.
# Secrets belong here or in a secret manager — never in source or in the
# frontend bundle (anything the browser can read is public).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Public URLs. APP_BASE_URL is used to build shareable product links
# (WhatsApp enquiry, Open Graph) so it must be the customer-facing origin.
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000

# Comma-separated allow-list of browser origins permitted to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Database (MongoDB Atlas) ----------------------------------------------
# Atlas: Database > Connect > Drivers. Create a DB user with readWrite on this
# database only, and restrict Network Access to your IPs — not 0.0.0.0/0.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/guddi_silai?retryWrites=true&w=majority

# --- Crypto secrets ---------------------------------------------------------
# Generate each one separately:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-64-random-chars-minimum-32
CSRF_SECRET=replace-me-with-a-different-64-random-chars
# Optional: set to your apex domain in production (e.g. .guddisilai.com)
COOKIE_DOMAIN=

# --- Razorpay ---------------------------------------------------------------
# Dashboard > Account & Settings > API Keys.  Use rzp_test_* keys in dev.
# KEY_ID is safe to expose to the browser; KEY_SECRET and WEBHOOK_SECRET are not.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks > add https://your-api/api/payments/webhook  (event: payment.captured, payment.failed)
RAZORPAY_WEBHOOK_SECRET=

# --- Cloudinary -------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=guddi-silai

# --- SMS OTP (MSG91) --------------------------------------------------------
# Provider is pluggable — see src/services/sms/. Set SMS_PROVIDER=console in
# dev to print the OTP to the server log instead of sending a real SMS.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_SENDER_ID=GUDDIS
MSG91_OTP_TEMPLATE_ID=

# --- Shiprocket -------------------------------------------------------------
# Shiprocket API user (Settings > API > Create an API user) — NOT your login.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary

# --- Google Sign-In ---------------------------------------------------------
# Only the Client ID is needed to verify ID tokens server-side.
GOOGLE_CLIENT_ID=

# --- Qwen via Groq ----------------------------------------------------------
# Used server-side by the admin "Generate with Qwen" product helper. Get the key
# from https://console.groq.com/keys — NEVER put it in frontend code.
GROQ_API_KEY=
# Optional: override the multimodal Qwen model (defaults to qwen/qwen3.8-27b).
# The model must be enabled on your Groq console.
QWEN_MODEL=
# Optional: official Groq OpenAI-compatible base URL (default is fine).
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Business settings (also editable later from the admin panel) -----------
WHATSAPP_NUMBER=919999999999
CALL_NUMBER=919999999999
# Optional: seed this verified mobile as the first SUPER_ADMIN account.
ADMIN_MOBILE=919999999999
# Rupees per 1 USD, used for foreign-currency display (README §32).
USD_RATE_INR=88
SHIPPING_FLAT_INR=79
FREE_SHIPPING_ABOVE_INR=1499
