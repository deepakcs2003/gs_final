# Copy to .env and fill in real values:  cp .env.example .env
# REQUIRED — the server will NOT start without these:
#   NODE_ENV, PORT, APP_BASE_URL, API_BASE_URL, CORS_ORIGINS, MONGODB_URI, JWT_SECRET, CSRF_SECRET

# App
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
API_BASE_URL=http://localhost:4000/api
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# In production the API also serves the built SPA so everything stays on one
# origin (cookies remain first-party). Point this at the built frontend:
#   PUBLIC_DIR=../frontend/dist
# Empty (default) = API-only mode.
PUBLIC_DIR=

# Bootstrap SUPER_ADMIN — `npm run seed` promotes this mobile number (OTP-login).
# Admin login is OTP-based; there is no password login in this app.
ADMIN_MOBILE=919999999999

# Database
MONGODB_URI="mongodb+srv://user:pass@cluster.example.net/dbname?retryWrites=true&w=majority"

# Auth — generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
CSRF_SECRET=
COOKIE_DOMAIN=

# Payments
# In production: MUST be a live key (rzp_live_*), NOT rzp_test_*. The server
# refuses to boot with a test key when NODE_ENV=production.
RAZORPAY_KEY_ID=rzp_...
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=guddi-silai

# SMS — "console" logs OTPs to the server log (dev); "msg91" sends real SMS.
# In production the server refuses to boot with SMS_PROVIDER=console.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_SENDER_ID=GUDDIS
MSG91_OTP_TEMPLATE_ID=

# Shiprocket (shipping)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
# 'true' = mock Shiprocket (default in dev), 'false' = always live, unset = mock in dev only
SHIPROCKET_MOCK=

# AI (admin product descriptions)
GROQ_API_KEY=
QWEN_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Contact / business
WHATSAPP_NUMBER=919999999999
CALL_NUMBER=919999999999
ADMIN_MOBILE=
USD_RATE_INR=88
SHIPPING_FLAT_INR=79
FREE_SHIPPING_ABOVE_INR=1499

# Google login (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Check all required env vars are present before starting:
#   npm run dev            (in backend/)